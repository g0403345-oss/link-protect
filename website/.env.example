# ── Discord OAuth (aus Discord Developer Portal) ────────────────────────────
# https://discord.com/developers/applications → deine App → OAuth2
DISCORD_CLIENT_ID=888390889892892684
DISCORD_CLIENT_SECRET=

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Zufälligen String generieren: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL deiner Website (ohne trailing slash)
NEXTAUTH_URL=https://dein-projekt.vercel.app

# ── Bot API Server ────────────────────────────────────────────────────────────
# URL des api_server.py auf deinem Bot-Server
BOT_API_URL=http://localhost:3001
# Muss mit BOT_API_SECRET in api_server.py übereinstimmen
BOT_API_SECRET=change-me-in-production

# ── Discord Bot Token (für Guild-Info via Discord API) ─────────────────────
BOT_TOKEN=
